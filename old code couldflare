async function md5(message) {
  const msgUint8 = new TextEncoder().encode(message);
  const hashBuffer = await crypto.subtle.digest('MD5', msgUint8);
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
}

export default {
  async fetch(request) {
    const url = new URL(request.url);
    const path = url.pathname;
    const host = url.origin;

    const referer = request.headers.get("Referer") || "";
    const requestOrigin = request.headers.get("Origin") || "";

    // ডোমেইন সিকিউরিটি চেক ফানশন
    function isAllowedDomain() {
      if (ALLOWED_ORIGINS.length === 0) return true;
      return ALLOWED_ORIGINS.some(allowed => 
        referer.startsWith(allowed) || requestOrigin.startsWith(allowed)
      );
    }

    // ডায়নামিক CORS হেডার সেট করা
    const clientOrigin = ALLOWED_ORIGINS.find(domain => referer.startsWith(domain) || requestOrigin.startsWith(domain)) || ALLOWED_ORIGINS[0] || "*";

    const corsHeaders = {
      "Access-Control-Allow-Origin": clientOrigin,
      "Access-Control-Allow-Methods": "GET, HEAD, POST, OPTIONS",
      "Access-Control-Allow-Headers": "*",
    };

    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    // [১] Referer / Origin Check - অননুমোদিত ওয়েবসাইট ব্লক করা
    if (ALLOWED_ORIGINS.length > 0 && !isAllowedDomain()) {
      return new Response("403 Forbidden: Access denied for this domain!", { 
        status: 403, 
        headers: corsHeaders 
      });
    }

    // [২] JSON ডাটা সার্ভিস (সিকিউর ইউআরএল জেনারেটর)
    if (path === "/" || path === "/data.json") {
      const expires = Math.floor(Date.now() / 1000) + (30 * 24 * 60 * 60);
      const publicData = [];

      for (let i = 0; i < MOVIES_DATABASE.length; i++) {
        const item = JSON.parse(JSON.stringify(MOVIES_DATABASE[i]));
        const itemId = `item_${i}`;

        if (item.CN) {
          for (const key of Object.keys(item.CN)) {
            if (item.CN[key].url) {
              const token = await md5(`${SECRET_KEY}-${expires}-${itemId}-cn-${key}`);
              item.CN[key].url = `${host}/play/${itemId}/cn-${key}?token=${token}&expires=${expires}`;
            }
          }
        }

        if (item.movielink) {
          const token = await md5(`${SECRET_KEY}-${expires}-${itemId}-movie`);
          item.movielink = `${host}/play/${itemId}/movie?token=${token}&expires=${expires}`;
        }

        if (item.episodes) {
          for (const key of Object.keys(item.episodes)) {
            const token = await md5(`${SECRET_KEY}-${expires}-${itemId}-${key}`);
            item.episodes[key] = `${host}/play/${itemId}/${key}?token=${token}&expires=${expires}`;
          }
        }

        publicData.push(item);
      }

      return new Response(JSON.stringify(publicData), {
        status: 200,
        headers: { ...corsHeaders, "Content-Type": "application/json; charset=utf-8" }
      });
    }

    // [৩] HLS প্রক্সি প্লে সার্ভিস
    if (path.startsWith("/play/")) {
      const parts = path.split("/play/")[1].split("/");
      const itemIdStr = parts[0];
      const epOrType = parts[1];
      const token = url.searchParams.get("token");
      const expires = url.searchParams.get("expires");

      if (!expires || Math.floor(Date.now() / 1000) > parseInt(expires)) {
        return new Response("403 Subscription Expired!", { status: 403, headers: corsHeaders });
      }

      const expectedHash = await md5(`${SECRET_KEY}-${expires}-${itemIdStr}-${epOrType}`);
      if (token !== expectedHash) {
        return new Response("403 Invalid Token!", { status: 403, headers: corsHeaders });
      }

      const index = parseInt(itemIdStr.replace("item_", ""));
      const targetItem = MOVIES_DATABASE[index];
      let realStreamUrl = null;

      if (targetItem) {
        if (epOrType === "movie") realStreamUrl = targetItem.movielink;
        else if (epOrType.startsWith("cn-")) {
          const cnKey = epOrType.replace("cn-", "");
          if (targetItem.CN && targetItem.CN[cnKey]) realStreamUrl = targetItem.CN[cnKey].url;
        } else if (targetItem.episodes && targetItem.episodes[epOrType]) {
          realStreamUrl = targetItem.episodes[epOrType];
        }
      }

      if (!realStreamUrl) {
        return new Response("404 Stream Not Found", { status: 404, headers: corsHeaders });
      }

      try {
        const targetUrl = new URL(realStreamUrl);
        const response = await fetch(targetUrl.href, {
          headers: {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
            "Referer": targetUrl.origin + "/"
          }
        });

        const contentType = response.headers.get("content-type") || "";
        if (realStreamUrl.endsWith(".mp4") || contentType.includes("video/mp4")) {
          const mp4Headers = new Headers(response.headers);
          Object.entries(corsHeaders).forEach(([k, v]) => mp4Headers.set(k, v));
          return new Response(response.body, { status: response.status, headers: mp4Headers });
        }

        let content = await response.text();
        const baseUrl = targetUrl.href.substring(0, targetUrl.href.lastIndexOf("/") + 1);

        content = content.replace(/^(?!#)(?!\s*$)(.+)$/gm, (match) => {
          if (match.startsWith("http://") || match.startsWith("https://")) {
            return match;
          }
          return new URL(match, baseUrl).href;
        });

        return new Response(content, {
          status: 200,
          headers: {
            ...corsHeaders,
            "Content-Type": "application/vnd.apple.mpegurl",
            "Cache-Control": "no-cache"
          }
        });
      } catch (err) {
        return new Response("Error fetching origin stream", { status: 500, headers: corsHeaders });
      }
    }

    return new Response("IPTV Proxy Active!", { status: 200, headers: corsHeaders });
  }
};
